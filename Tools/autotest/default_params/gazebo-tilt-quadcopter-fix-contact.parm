# Gazebo Classic tilt_quadcopter_fix ADM002 contact-control configuration
FRAME_CLASS 7
FRAME_TYPE 23
MOT_TILT_EN 1
MOT_TILT_ANG_MAX 135
# Gazebo tilt joints use the opposite positive-angle convention from the
# Quad-Tilt allocator.  Reverse all four model servos so position feedback is
# negative rather than positive (verified from run07 PN/PSCN/RCOU curves).
MOT_SVO_RF_REV 1
MOT_SVO_RR_REV 1
MOT_SVO_LR_REV 1
MOT_SVO_LF_REV 1

# ADM002 2.8.3 high-speed firmware stream, simulated at 100 Hz on SERIAL6
SERIAL6_PROTOCOL 52
SERIAL6_BAUD 115

# Forward DISTANCE_SENSOR stream on SERIAL7
SERIAL7_PROTOCOL 2
SERIAL7_BAUD 115
RNGFND1_TYPE 10
RNGFND1_ORIENT 0
RNGFND1_MIN 0.05
RNGFND1_MAX 10

# Keep battery behaviour deterministic for the first contact validation
BATT_MONITOR 0

# Conservative first-pass direct force controller
IMPD_FREF 1.0
IMPD_FREF_MAX 3.0
IMPD_F_ABORT 8.0
IMPD_F_KP 0.06
IMPD_F_KI 0.015
IMPD_F_IMAX 0.40
IMPD_FX_MAX 0.40
IMPD_FX_RATE 0.25
IMPD_APP_SPD 0.10
IMPD_SLOW_SPD 0.03
IMPD_SLOW_DIST 0.30
IMPD_RET_DIST 0.50
IMPD_APP_TOUT 45
IMPD_RET_TOUT 15
IMPD_RFND_IDX 0
IMPD_SAT_TOUT 1.0
IMPD_FS_REV 0
IMPD_REL_TOUT 5.0
IMPD_F_OFF 0.10
