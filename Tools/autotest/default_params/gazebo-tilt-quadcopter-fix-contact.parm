# Gazebo Classic tilt_quadcopter_fix ADM002 contact-control configuration
FRAME_CLASS 7
FRAME_TYPE 23
# Original Gazebo UDP order: eight propellers, then RF/RR/LR/LF tilt servos.
SERVO1_FUNCTION 33
SERVO1_MIN 1100
SERVO1_MAX 1900
SERVO1_TRIM 1500
SERVO2_FUNCTION 34
SERVO2_MIN 1100
SERVO2_MAX 1900
SERVO2_TRIM 1500
SERVO3_FUNCTION 35
SERVO3_MIN 1100
SERVO3_MAX 1900
SERVO3_TRIM 1500
SERVO4_FUNCTION 36
SERVO4_MIN 1100
SERVO4_MAX 1900
SERVO4_TRIM 1500
SERVO5_FUNCTION 37
SERVO5_MIN 1100
SERVO5_MAX 1900
SERVO5_TRIM 1500
SERVO6_FUNCTION 38
SERVO6_MIN 1100
SERVO6_MAX 1900
SERVO6_TRIM 1500
SERVO7_FUNCTION 39
SERVO7_MIN 1100
SERVO7_MAX 1900
SERVO7_TRIM 1500
SERVO8_FUNCTION 40
SERVO8_MIN 1100
SERVO8_MAX 1900
SERVO8_TRIM 1500
SERVO9_FUNCTION 184
SERVO9_MIN 500
SERVO9_MAX 2500
SERVO9_TRIM 1500
SERVO10_FUNCTION 185
SERVO10_MIN 500
SERVO10_MAX 2500
SERVO10_TRIM 1500
SERVO11_FUNCTION 186
SERVO11_MIN 500
SERVO11_MAX 2500
SERVO11_TRIM 1500
SERVO12_FUNCTION 187
SERVO12_MIN 500
SERVO12_MAX 2500
SERVO12_TRIM 1500
MOT_TILT_EN 1
MOT_TILT_ANG_MAX 135
# Gazebo tilt joints use the opposite positive-angle convention from the
# Quad-Tilt allocator.  Reverse all four model servos so position feedback is
# negative rather than positive (verified from run07 PN/PSCN/RCOU curves).
MOT_SVO_RF_REV 1
MOT_SVO_RR_REV 1
MOT_SVO_LR_REV 1
MOT_SVO_LF_REV 1

# ADM002 2.8.3 high-speed firmware stream, simulated at 100 Hz on SERIAL6
SERIAL6_PROTOCOL 52
SERIAL6_BAUD 115

# Forward DISTANCE_SENSOR stream on SERIAL7
SERIAL7_PROTOCOL 2
SERIAL7_BAUD 115
# Keep the peripheral MAVLink stream alive so the Gazebo rangefinder can
# learn the ArduPilot UDP peer before returning DISTANCE_SENSOR frames.
SR7_RAW_SENS 10
SR7_EXT_STAT 2
SR7_POSITION 5
RNGFND1_TYPE 10
RNGFND1_ORIENT 0
RNGFND1_MIN 0.05
RNGFND1_MAX 10

# Keep battery behaviour deterministic for the first contact validation
BATT_MONITOR 0

# Conservative first-pass direct force controller
IMPD_FREF 1.0
IMPD_FREF_MAX 3.0
IMPD_F_ABORT 8.0
IMPD_F_KP 0.06
IMPD_F_KI 0.015
IMPD_F_IMAX 0.40
IMPD_FX_MAX 0.40
IMPD_FX_RATE 0.25
IMPD_APP_SPD 0.10
IMPD_SLOW_SPD 0.03
IMPD_SLOW_DIST 0.30
IMPD_RET_DIST 0.50
IMPD_APP_TOUT 45
IMPD_RET_TOUT 15
IMPD_RFND_IDX 0
IMPD_SAT_TOUT 1.0
IMPD_FS_REV 0
IMPD_REL_TOUT 5.0
IMPD_F_OFF 0.10
# Ensure MAVROS TCP SERIAL0 receives DISTANCE_SENSOR packets
SR0_RAW_SENS 10
