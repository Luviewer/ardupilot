# Pixhawk6C-Mini - RT-Thread build
# Holybro Pixhawk 6C Mini: STM32H743, 2MB flash. RTT BSP: stm32/stm32h743-pixhawk6c-mini.

BOARD_NAME pixhawk6c_mini
MCU STM32H7xx STM32H743xx

# 2M flash (Pixhawk6C), 128KB reserved for PX4/AP bootloader
FLASH_SIZE_KB 2048
FLASH_RESERVE_START_KB 128
OSCILLATOR_HZ 16000000

# Serial order for RTT (OTG1=USB first, then UARTs; Pixhawk6C: OTG1 UART7 UART5 USART1 UART8 USART2 USART3)
SERIAL_ORDER OTG1 UART7 UART5 USART1 UART8 USART2 USART3

# APJ board ID for bootloader/GCS (same as ChibiOS Pixhawk6C)
APJ_BOARD_ID TARGET_HW_PX4_FMU_V6C

# Battery monitor analog pins (channel indices in RTT _adc_map: 0=PC5 BATT_VOLT, 1=PC4 BATT_CURR)
define HAL_BATT_VOLT_PIN 0
define HAL_BATT_CURR_PIN 1
define HAL_BATT_VOLT_SCALE 18.18
define HAL_BATT_CURR_SCALE 36.36
define HAL_HAVE_BOARD_VOLTAGE 1
