# for module compiling
import os
import sys
import subprocess
Import('env')
from building import *

cwd = GetCurrentDir()
objs = []
dirlist = os.listdir(cwd)

# Add package include paths so board/application code can find stm32h7xx.h, core_cm7.h and HAL
env.Append(CPPPATH = [
    os.path.join(cwd, 'packages', 'CMSIS-Core-latest', 'Include'),
    os.path.join(cwd, 'packages', 'stm32h7_cmsis_driver-latest', 'Include'),
    os.path.join(cwd, 'packages', 'stm32h7_hal_driver-latest', 'Inc'),
])
# CherryUSB needs usb_config.h from board/ports/cherryusb
if GetDepend(['RT_CHERRYUSB_DEVICE']) and GetDepend(['BSP_USING_USB_DEVICE']):
    env.Append(CPPPATH = [os.path.join(cwd, 'board', 'ports', 'cherryusb')])

# STM32H743xx || STM32H750xx || STM32F753xx; USE_HAL_DRIVER for stm32h7xx.h to include HAL
env.Append(CPPDEFINES = ['STM32H743xx', 'USE_HAL_DRIVER'])

# Full ArduPilot build: ARDUPILOT_FULL=1 => skip applications (single main from ArduCopter), add ArduPilot sources and link once
# AP_ROOT: works both when run from rtt_bsp (3 levels up) and when deployed to modules/rt-thread/bsp/stm32/stm32h743-pixhawk6c-mini (5 levels up)
ARDUPILOT_FULL = os.environ.get('ARDUPILOT_FULL', '0') == '1'

if ARDUPILOT_FULL:
    AP_ROOT = os.environ.get('AP_ROOT', '')
    if not AP_ROOT or not os.path.isfile(os.path.join(AP_ROOT, 'Tools', 'scripts', 'scons_ardupilot_sources.py')):
        for n in [5, 3]:
            AP_ROOT = os.path.abspath(os.path.join(cwd, *(['..'] * n)))
            if os.path.isfile(os.path.join(AP_ROOT, 'Tools', 'scripts', 'scons_ardupilot_sources.py')):
                break
    # C++ runtime for ArduPilot .cpp objects (libstdc++, libsupc++)
    env.Append(LINKFLAGS=' -Wl,--start-group -lstdc++ -lsupc++ -lgcc -Wl,--end-group')
    env.Append(LIBS=['stdc++', 'supc++', 'gcc'])
    # Allow duplicate definition (e.g. AP_FWVersion::fwver in multiple .o) so link can complete
    env.Append(LINKFLAGS=' -Wl,--allow-multiple-definition')
    config_py = os.path.join(cwd, 'scons_ardupilot_config.py')
    if not os.path.isfile(config_py):
        script = os.path.join(AP_ROOT, 'Tools', 'scripts', 'scons_ardupilot_sources.py')
        if os.path.isfile(script):
            subprocess.check_call([sys.executable, script, AP_ROOT, '--board', 'rtt_pixhawk6c_mini', '--bsp-dir', cwd, '--output', cwd])
    if os.path.isfile(config_py):
        with open(config_py) as f:
            exec(f.read())
        env.Append(CPPPATH=ap_cpppath)
        # Do not append ap_defines to global env (e.g. __ICCARM__=0 would make RTT/finsh use IAR branch)
        ap_force_include = os.path.join(cwd, 'board', 'ardupilot_posix_include.h') if os.path.isfile(os.path.join(cwd, 'board', 'ardupilot_posix_include.h')) else ''
        ap_obj_root = os.path.join(AP_ROOT, 'build', 'rtt_pixhawk6c_mini', 'ap_objects')
        ap_objs = SConscript(os.path.join(AP_ROOT, 'SConscript_ardupilot'), exports=['env', 'ap_sources', 'ap_cpppath', 'ap_defines', 'ap_force_include', 'ap_obj_root'], duplicate=0)
        objs.extend(list(ap_objs))

for d in dirlist:
    if ARDUPILOT_FULL and d == 'applications':
        continue
    path = os.path.join(cwd, d)
    if os.path.isfile(os.path.join(path, 'SConscript')):
        objs = objs + SConscript(os.path.join(d, 'SConscript'))

# Flatten so DoBuilding gets a plain list of nodes (RTT Groups/NodeLists otherwise break .abspath iteration)
def _flatten_objs(lst):
    out = []
    for item in lst:
        if type(item) == type([]):
            out.extend(_flatten_objs(item))
        elif hasattr(item, '__iter__') and not hasattr(item, 'abspath'):
            out.extend(_flatten_objs(list(item)))
        else:
            out.append(item)
    return out
objs = _flatten_objs(objs)

Return('objs')
