# Scorpio六足串行舵机CAN板硬件定义
env AP_PERIPH 1

MCU STM32F4xx STM32F405xx

# Bootloader占用前64 KiB，应用从64 KiB处启动。
FLASH_RESERVE_START_KB 64
FLASH_SIZE_KB 1024

STORAGE_FLASH_PAGE 2
define HAL_STORAGE_SIZE 15360

# 沿用USLF4-CAN板号以兼容已烧写的Bootloader。
APJ_BOARD_ID 1014

define STM32_ST_USE_TIMER 5
define CH_CFG_ST_RESOLUTION 32

# PWR.pdf中的X1标注为8 MHz，但当前实物使用16 MHz晶振。
OSCILLATOR_HZ 16000000

# PWR原理图中的红色状态灯，低电平点亮。
PA6 LED OUTPUT HIGH GPIO(90)
define AP_NOTIFY_GPIO_LED_1_ENABLED 1
define AP_NOTIFY_GPIO_LED_1_PIN 90

define HAL_NO_GPIO_IRQ
define SERIAL_BUFFERS_SIZE 512
define PORT_INT_REQUIRED_STACK 64

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define HAL_USE_RTC FALSE
define DMA_RESERVE_SIZE 0
define HAL_DEVICE_THREAD_STACK 768
define AP_PARAM_MAX_EMBEDDED_PARAM 512
env ROMFS_UNCOMPRESSED True

# CAN1：PA11接收、PA12发送；原理图R14已安装120欧终端。
PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1
define CAN_APP_NODE_NAME "USLCAN-Scorpio"

# SERIAL1～SERIAL6严格按PWR.pdf连接器SERVO1～SERVO6编号：
# SERVO1=UART5，SERVO2=USART1，SERVO3=USART6，
# SERVO4=USART3，SERVO5=USART2，SERVO6=UART4。
SERIAL_ORDER EMPTY UART5 USART1 USART6 USART3 USART2 UART4

# SERVO1 / UART5
PC12 UART5_TX UART5 SPEED_HIGH NODMA
PD2  UART5_RX UART5 SPEED_HIGH NODMA

# SERVO2 / USART1
PA9  USART1_TX USART1 SPEED_HIGH NODMA
PA10 USART1_RX USART1 SPEED_HIGH NODMA

# SERVO3 / USART6
PC6 USART6_TX USART6 SPEED_HIGH NODMA
PC7 USART6_RX USART6 SPEED_HIGH NODMA

# SERVO4 / USART3
PB10 USART3_TX USART3 SPEED_HIGH NODMA
PB11 USART3_RX USART3 SPEED_HIGH NODMA

# SERVO5 / USART2
PA2 USART2_TX USART2 SPEED_HIGH NODMA
PA3 USART2_RX USART2 SPEED_HIGH NODMA

# SERVO6 / UART4
PA0 UART4_TX UART4 SPEED_HIGH NODMA
PA1 UART4_RX UART4 SPEED_HIGH NODMA

define HAL_USE_ADC FALSE
define HAL_USE_Hiwonder_Servo TRUE

# SERIAL0为空；保留原板的串口重启监听索引以维持配置兼容。
define HAL_PERIPH_LISTEN_FOR_SERIAL_UART_REBOOT_CMD_PORT 0
define HAL_PERIPH_ENABLE_RC_OUT
