# Scorpio六足串行舵机CAN板Bootloader硬件定义
env AP_PERIPH 1

MCU STM32F4xx STM32F405xx
# PWR.pdf中的X1标注为8 MHz，但当前实物使用16 MHz晶振。
OSCILLATOR_HZ 16000000

# 沿用USLF4-CAN板号，确保Bootloader与应用固件身份一致。
APJ_BOARD_ID 1014

FLASH_RESERVE_START_KB 0
FLASH_SIZE_KB 1024
FLASH_BOOTLOADER_LOAD_KB 64

PA6 LED_BOOTLOADER OUTPUT HIGH GPIO(0)
define HAL_LED_ON 0

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define HAL_USE_SERIAL TRUE
define STM32_SERIAL_USE_USART1 TRUE
define STM32_SERIAL_USE_USART2 TRUE
define STM32_SERIAL_USE_USART3 TRUE
define STM32_SERIAL_USE_UART4 TRUE
define STM32_SERIAL_USE_UART5 TRUE
define STM32_SERIAL_USE_USART6 TRUE

# Bootloader不使用UART传输，但仍声明六个外设和引脚，保证ChibiOS硬件定义完整。
SERIAL_ORDER
PC12 UART5_TX UART5 SPEED_HIGH
PD2  UART5_RX UART5 SPEED_HIGH
PA9  USART1_TX USART1 SPEED_HIGH
PA10 USART1_RX USART1 SPEED_HIGH
PC6  USART6_TX USART6 SPEED_HIGH
PC7  USART6_RX USART6 SPEED_HIGH
PB10 USART3_TX USART3 SPEED_HIGH
PB11 USART3_RX USART3 SPEED_HIGH
PA2 USART2_TX USART2 SPEED_HIGH
PA3 USART2_RX USART2 SPEED_HIGH
PA0 UART4_TX UART4 SPEED_HIGH
PA1 UART4_RX UART4 SPEED_HIGH

PA11 CAN1_RX CAN1
PA12 CAN1_TX CAN1

define HAL_USE_CAN TRUE
define STM32_CAN_USE_CAN1 TRUE
define CAN_APP_NODE_NAME "USLCAN-Scorpio"
