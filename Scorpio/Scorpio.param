# Scorpio 联合仿真：飞行执行器走 Gazebo 16 路 PWM，六足走 vcan0/DroneCAN。

# Scorpio 独立三旋翼倾转分配器。通道顺序：前右电机、后电机、前左电机、
# 前右倾转、后倾转、前左倾转。
FRAME_CLASS,18
FRAME_TYPE,0
SERVO1_FUNCTION,33
SERVO2_FUNCTION,34
SERVO3_FUNCTION,35
SERVO4_FUNCTION,76
SERVO5_FUNCTION,45
SERVO6_FUNCTION,75
SERVO4_MIN,1000
SERVO4_TRIM,1500
SERVO4_MAX,2000
SERVO5_MIN,1000
SERVO5_TRIM,1500
SERVO5_MAX,2000
SERVO6_MIN,1000
SERVO6_TRIM,1500
SERVO6_MAX,2000
MOT_THST_HOVER,0.50
# 旋翼中心相对机体原点的 FRD 平面坐标（m）：X前、Y右。
MOT_SC_FR_X,0.18811
MOT_SC_FR_Y,0.20529
MOT_SC_FL_X,0.18811
MOT_SC_FL_Y,-0.20529
MOT_SC_R_X,-0.22917
MOT_SC_R_Y,0.0
MOT_SC_F_ANG,30
MOT_SC_R_ANG,90
MOT_SC_TILT_MAX,45
MOT_SC_XY_GAIN,1.0

HEX_ENABLE,1
HEX_CLASS,0
# 六足运动轴使用扩展RC通道，避免与飞控RC1横滚、RC2俯仰、RC3油门、RC4偏航冲突。
HEX_CH_THR_X,9
HEX_CH_THR_Y,13
HEX_CH_YAW,14
# 地面六足步态暂不使用AHRS滚转/俯仰补偿；避免落足冲击经PID反馈到六条腿。
HEX_CH_ROL,-1
HEX_CH_PIT,-1
# 当前实现将 HGH/LIFT 直接解释为毫米偏移，而不是RC通道号。
HEX_CH_HGH,0
HEX_CH_LIFT,20
HEX_CH_MODE,10
HEX_CH_WAK,11
HEX_CH_FLY,12

# SITL CAN1 使用 Linux SocketCAN vcan0，CAN 驱动1运行 DroneCAN。
SIM_CAN_TYPE1,2
CAN_P1_DRIVER,1
CAN_D1_PROTOCOL,1
CAN_D1_PROTOCOL2,0
